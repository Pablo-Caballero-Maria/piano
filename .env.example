# Settings of the teacher's PC. ./install.sh fills them in for you (tools/configure.py asks), or
# copy this to .env (git ignores it; chmod 600) and fill it in. NEVER commit .env: the repository
# is public. Vercel needs PIANO_DATA_KEY, MONGODB_URI and ABLY_API_KEY too.

# The system key: encrypts everything stored on the boards and in Atlas. Create it ONCE with
# `uv run python -m fog keygen` and use the same one on every teacher PC and on Vercel.
PIANO_DATA_KEY=

# This class's board, and the PC's public name (HTTPS certificate, MQTT for the board):
# https://<DUCKDNS_DOMAIN>.duckdns.org
PIANO_BOARD_ID=piano1
PIANO_PUBLIC_URL=
# PIANO_SERVER_IP=192.168.1.10   optional: the board connects here instead of resolving the name

# DuckDNS (https://www.duckdns.org): this classroom's name (each classroom its own) and the token
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# The classroom router's WiFi: the board joins it (tools/board.py setup), and so does this PC
WIFI_SSID=
WIFI_PASSWORD=

# MQTT passwords: deploy/setup.sh generates them if empty
MQTT_FOG_PASSWORD=
MQTT_BOARD_PASSWORD=

# Cloud (optional: without them the class works offline only)
MONGODB_URI=
ABLY_API_KEY=

# Optional: PIANO_AUTO_UPDATE=0 disables updates from GitHub; PIANO_UPDATE_EVERY_S, PIANO_SYNC_EVERY_S
