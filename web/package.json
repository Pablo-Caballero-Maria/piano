{
  "name": "piano-web",
  "version": "1.3.0",
  "private": true,
  "description": "The piano lessons website: Next.js (static export), served by Vercel and by each teacher's PC",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/build-auth-server.mjs && node scripts/write-headers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "headers:vercel": "node scripts/write-headers.mjs --vercel && prettier --write ../vercel.json"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@serwist/turbopack": "9.5.15",
    "@tanstack/react-query": "5.108.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "better-auth": "1.7.27",
    "lucide-react": "1.75.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "serwist": "9.5.15",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
