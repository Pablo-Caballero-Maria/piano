    given-names: "Pablo"
version: 1.1.0
date-released: 2026-11-21
license: MIT
repository-code: "https://github.com/Pablo-Caballero-Maria/piano"
url: "https://piano-web-virid.vercel.app"
keywords:
  - "ESP32"
  - "MicroPython"
  - "IoT"
