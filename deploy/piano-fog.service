# The teacher's PC app (installed in /etc/systemd/system/ by deploy/setup.sh).
# Restart=always: it restarts itself after updating from GitHub (fog/updater.py).
[Unit]
Description=Piano class: the teacher's PC (fog node)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@UV@ run --frozen python -m fog serve
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
